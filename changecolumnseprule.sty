\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{changecolumnseprule}[2026/10/26 v0.3]
\RequirePackage{etoolbox}

% Patch only the rule, retaining the output routine of the installed LaTeX
% and multicol (including their column boxes, marks and float handling).
\def\changecolumnseprule@patcherror#1{%
  \PackageError{changecolumnseprule}{Cannot patch #1}%
    {The output routine is not supported. The original routine is retained.}%
}
\let\original@outputdblcol\@outputdblcol
\let\changecolumnseprule@outputdblcol\@outputdblcol
\patchcmd{\changecolumnseprule@outputdblcol}%
  {\normalcolor\vrule\@width\columnseprule}%
  {\makebox[\z@][c]{\vbox to\@colht{\changecolumnseprule@content}}}%
  {}{\changecolumnseprule@patcherror{\string\@outputdblcol}}

\newif\if@changecolumnsep@multicol@LR
\def\changecolumnseprule@direction{%
  \ifx\mc@align@columns\LR@column@boxes
    \@changecolumnsep@multicol@LRtrue
  \else
    \@changecolumnsep@multicol@LRfalse
  \fi
}
\def\changecolumnseprule@align{%
  \if@changecolumnsep@multicol@LR
    \LRmulticolcolumns
  \else
    \RLmulticolcolumns
  \fi
}
\def\restorecolumnseprule@multicol{}
\def\changecolumnseprule@multicol{}
\@ifpackageloaded{multicol}{%
  \let\original@LR@column@boxes\LR@column@boxes
  \let\original@RL@column@boxes\RL@column@boxes
  \let\changecolumnseprule@LR@column@boxes\LR@column@boxes
  \let\changecolumnseprule@RL@column@boxes\RL@column@boxes
  \patchcmd{\changecolumnseprule@LR@column@boxes}%
    {\columnseprulecolor\vrule\@width\columnseprule}%
    {\makebox[\z@][c]{\vbox to\ht\mult@rightbox{\changecolumnseprule@content}}}%
    {}{\changecolumnseprule@patcherror{\string\LR@column@boxes}}%
  \patchcmd{\changecolumnseprule@RL@column@boxes}%
    {\columnseprulecolor\vrule\@width\columnseprule}%
    {\makebox[\z@][c]{\vbox to\ht\mult@rightbox{\changecolumnseprule@content}}}%
    {}{\changecolumnseprule@patcherror{\string\RL@column@boxes}}%
  \def\restorecolumnseprule@multicol{%
    \changecolumnseprule@direction
    \let\LR@column@boxes\original@LR@column@boxes
    \let\RL@column@boxes\original@RL@column@boxes
    \changecolumnseprule@align
  }%
  \def\changecolumnseprule@multicol{%
    \changecolumnseprule@direction
    \let\LR@column@boxes\changecolumnseprule@LR@column@boxes
    \let\RL@column@boxes\changecolumnseprule@RL@column@boxes
    \changecolumnseprule@align
  }%
}{}

\def\restorecolumnseprule{%
  \let\@outputdblcol\original@outputdblcol
  \restorecolumnseprule@multicol
}
\def\changecolumnseprule#1{%
  \def\changecolumnseprule@content{#1}%
  \let\@outputdblcol\changecolumnseprule@outputdblcol
  \changecolumnseprule@multicol
}
\endinput
